# Copy this file to .env and fill in your values. Never commit .env to git.

# development (default) or production. Production requires a strong SECRET_KEY,
# sends cookies over HTTPS only and turns on HSTS.
APP_ENV=development

# Random value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development a random key is used if this is missing (you are signed out on restart).
SECRET_KEY=

# Free key from https://console.groq.com (optional: without it the app uses a rule-based summary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set to 1 only on your own machine to get auto-reload. Never in production.
FLASK_DEBUG=0
